{
  "id": "cn.vastplan.foundation.versioning.workspace",
  "name": "VastPlan Version Workspace",
  "version": "0.5.1",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "description": "提供受信版本环境、Snapshot 编辑会话、内容上传代理、Lease、配额、CAS 和标准资源 Adapter 编排",
  "engines": { "backend": "^0.1" },
  "capabilities": { "kernelServices": [], "credentials": [], "resources": [] },
  "contextAccess": {
    "required": ["caller", "scope.tenant"],
    "optional": ["scope.project", "scene", "trace", "request.deadline", "request.idempotency", "propagation.callPath"]
  },
  "runtime": {
    "instancePolicy": "leader",
    "stateModel": "leader-owned",
    "visibility": "cluster",
    "routing": "leader",
    "routingDomain": "platform",
    "requires": [
      {
        "capability": "foundation.versioning.ledger", "contractRange": "^1.0.0",
        "scope": "remote",
        "kind": "strong",
        "ready": "readiness",
        "failurePolicy": "fail",
        "logicalService": "foundation.versioning.ledger",
        "routingDomain": "platform"
      },
      {
        "capability": "foundation.versioning.content-staging", "contractRange": "^1.0.0",
        "scope": "remote",
        "kind": "soft",
        "ready": "readiness",
        "failurePolicy": "degrade",
        "logicalService": "foundation.versioning.content-staging",
        "routingDomain": "platform"
      },
      {
        "capability": "foundation.versioning.content-reference", "contractRange": "^1.0.0",
        "scope": "remote",
        "kind": "soft",
        "ready": "readiness",
        "failurePolicy": "degrade",
        "logicalService": "foundation.versioning.content-reference",
        "routingDomain": "platform"
      }
    ],
    "provides": [
      {
        "extensionPoint": "tool.package",
        "capability": "foundation.versioning.workspace", "contractVersion": "1.0.0",
        "visibility": "cluster",
        "routing": "leader",
        "routingDomain": "platform"
      }
    ]
  },
  "execution": { "backend": { "driver": "native", "minimumIsolation": "trusted-process" } },
  "configuration": {
    "scope": "service",
    "applyMode": "restart",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environments"],
      "properties": {
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol", "id", "revision", "bindings", "limits"],
            "properties": {
              "protocol": { "const": "version.resource.v1" },
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
              "revision": { "type": "integer", "minimum": 1 },
              "bindings": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["resourceType", "namespace", "adapter", "allowedModes", "defaultMode", "projectionPolicy"],
                  "properties": {
                    "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
                    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
                    "adapter": { "enum": ["version.resource.json.v1", "version.resource.text.v1", "version.resource.blob.v1", "version.resource.files.v1"] },
                    "allowedModes": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "snapshot" } },
                    "defaultMode": { "const": "snapshot" },
                    "projectionPolicy": { "enum": ["none", "domain-hot", "current-only"] },
                    "adapterConfig": { "type": "object", "additionalProperties": false }
                  }
                }
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "required": ["maxSessionsPerTenant", "maxLeaseSeconds", "maxSnapshotBytes", "maxOverlayBytes"],
                "properties": {
                  "maxSessionsPerTenant": { "type": "integer", "minimum": 1, "maximum": 10000 },
                  "maxLeaseSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
                  "maxSnapshotBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
                  "maxOverlayBytes": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    }
  },
  "activation": ["onStartup"],
  "entry": { "backend": "backend/version-workspace" },
  "contributes": {
    "backend": {
      "tools": [
        {
          "id": "foundation.versioning.workspace",
          "service_role": "backend",
          "title": "Version Workspace",
          "subcommands": [
            { "name": "describeResource", "description": "解析资源绑定与可选能力" },
            { "name": "open", "description": "打开有 Lease 的版本编辑会话" },
            { "name": "status", "description": "读取会话状态" },
            { "name": "readSnapshot", "description": "读取隔离快照" },
            { "name": "writeSnapshot", "description": "以 CAS 写入隔离快照" },
            { "name": "changes", "description": "读取摘要变化与可选详细 diff" },
            { "name": "commit", "description": "以稳定 operationId 幂等提交版本并可选更新 Head" },
            { "name": "discard", "description": "丢弃编辑会话" },
            { "name": "renew", "description": "在环境配额内续租" },
            { "name": "readCommitted", "description": "读取并规范化精确已提交版本" },
            { "name": "compareCommitted", "description": "比较摘要并按 Adapter 能力返回详细 diff" },
            { "name": "beginContentUpload", "description": "为当前 Session revision 创建内容上传 Lease" },
            { "name": "contentUploadStatus", "description": "读取 Session 已绑定的内容上传状态" },
            { "name": "renewContentUpload", "description": "续租 Session 已绑定的内容上传" },
            { "name": "completeContentUpload", "description": "完成内容校验并记录 Ready 绑定" },
            { "name": "abortContentUpload", "description": "终止 Session 已绑定的内容上传" }
          ]
        }
      ]
    }
  }
}
