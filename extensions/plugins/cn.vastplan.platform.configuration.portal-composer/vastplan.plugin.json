{
  "id": "cn.vastplan.platform.configuration.portal-composer",
  "name": "VastPlan Portal Composer",
  "description": "以单一 Portal 聚合治理 WorkingCopy、Publication、Release 与用户级 PortalPreference",
  "version": "6.2.0",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "engines": { "backend": "^0.1", "frontend": "^1.0" },
  "capabilities": { "kernelServices": ["kernel.config.get", "kernel.portal.catalog.compile-browser-exposure", "kernel.portal.catalog.validate", "kernel.portal.catalog.materialize", "kernel.portal.artifact-references.publish", "kernel.portal.test-artifact.validate", "kernel.state.shared.get", "kernel.state.shared.create", "kernel.state.shared.update"], "credentials": [], "resources": [] },
  "contextAccess": { "required": ["scope.tenant", "caller", "subject.id"], "optional": ["scene", "trace", "request.deadline", "request.idempotency", "propagation.callPath"] },
  "authorization": {
    "namespace": "platform.portal",
    "capabilities": ["platform.portal-composer"],
    "permissions": [
      { "code": "platform.portal.read", "title": "查看 Portal 治理", "scope": "platform", "risk": "low", "assignable": true, "offlineAllowed": false },
      { "code": "platform.portal.compose", "title": "编辑 Portal 组合草稿", "scope": "platform", "risk": "high", "assignable": true, "offlineAllowed": false },
      { "code": "platform.portal.approve", "title": "审批 Portal 组合", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false },
      { "code": "platform.portal.publish", "title": "发布或回滚 Portal 组合", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false }
    ],
    "operationGuards": [
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "portalGovernance", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "listPortalReleases", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "portalVersionHistory", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "readPortalVersion", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "comparePortalVersions", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "audit", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "listTestTargetBindings", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "listTestReleases", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "createPortal", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "createPortalWorkingCopy", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "savePortalWorkingCopy", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "restorePortalVersion", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "submitPortalPublication", "permissions": ["platform.portal.compose"], "access": "execute", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "approvePortalPublication", "permissions": ["platform.portal.approve"], "access": "approve", "approval": "policy" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "publishPortalPublication", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "releasePortalPublication", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "putTestTargetBinding", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "rollbackPortalRelease", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "createTestRelease", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "rollbackTestRelease", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" }
    ]
  },
  "runtime": {
    "instancePolicy": "active-active",
    "stateModel": "external-shared",
    "visibility": "cluster",
    "routing": "queue",
    "routingDomain": "platform",
    "requires": [
      { "capability": "foundation.security.approval-policy", "scope": "remote", "kind": "strong", "ready": "readiness", "failurePolicy": "fail" },
      { "capability": "foundation.versioning.workspace", "scope": "remote", "kind": "lazy", "ready": "readiness", "failurePolicy": "degrade", "logicalService": "foundation.versioning.workspace", "routingDomain": "platform" }
    ],
    "provides": [
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "visibility": "cluster", "routing": "queue", "routingDomain": "platform" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-preference", "visibility": "cluster", "routing": "queue", "routingDomain": "platform" }
    ]
  },
  "execution": { "backend": { "driver": "native", "minimumIsolation": "trusted-process" } },
  "configuration": {
    "scope": "service",
    "applyMode": "restart",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform.portal-composer.platformCatalog", "platform.portal-composer.approvalPolicy"],
      "properties": {
        "platform.portal-composer.platformCatalog": { "type": "string", "minLength": 2 },
        "platform.portal-composer.approvalPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "capability", "logicalService", "routingDomain", "profile"],
          "properties": {
            "protocol": { "const": "approval.policy.v2" },
            "capability": { "const": "foundation.security.approval-policy" },
            "logicalService": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
            "routingDomain": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
            "profile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "revision", "digest"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
                "revision": { "type": "integer", "minimum": 1 },
                "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        },
        "platform.portal-composer.versionControl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["environmentId", "resourceType"],
          "properties": {
            "environmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$" },
            "resourceType": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" }
          }
        }
      }
    }
  },
  "state": { "backend": { "format": "cn.vastplan.platform.portal-composer.shared", "formatVersion": 5, "migration": { "protocol": "lifecycle.v1", "from": [{ "format": "cn.vastplan.platform.portal-composer.shared", "formatVersion": 4 }] } } },
  "activation": ["onStartup", "onPortalStartup"],
  "entry": { "backend": "backend/portal-composer", "frontend": "frontend/dist/index.js" },
  "contributes": {
    "backend": {
      "tools": [{
        "id": "platform.portal-composer",
        "service_role": "backend",
        "title": "门户组合治理",
        "subcommands": [
          { "name": "preparePluginInstallation", "description": "为受信部署候选预热一个显式目标 Portal", "audience": "workload" },
          { "name": "commitPluginInstallation", "description": "提交已预热的 Portal 插件安装代次", "audience": "workload" },
          { "name": "abortPluginInstallation", "description": "中止尚未提交的 Portal 插件安装准备", "audience": "workload" },
          { "name": "rollbackPluginInstallation", "description": "回滚已提交的 Portal 插件安装代次", "audience": "workload" },
          { "name": "portalGovernance", "description": "读取 Portal、WorkingCopy、Publication 与 Release", "audience": "user" },
          { "name": "listPortalReleases", "description": "读取运行时需要的 Portal 上线记录", "audience": "user" },
          { "name": "createPortal", "description": "创建 Portal 及首个完整配置版本", "audience": "user" },
          { "name": "createPortalWorkingCopy", "description": "为已发布 Portal 创建下一轮 WorkingCopy", "audience": "user" },
          { "name": "savePortalWorkingCopy", "description": "以 revision CAS 保存当前 WorkingCopy", "audience": "user" },
          { "name": "submitPortalPublication", "description": "冻结 WorkingCopy 并提交 Publication", "audience": "user" },
          { "name": "approvePortalPublication", "description": "按 ApprovalPolicy 审批 Publication", "audience": "user" },
          { "name": "publishPortalPublication", "description": "发布已审批的 Publication", "audience": "user" },
          { "name": "releasePortalPublication", "description": "将 Published Publication 上线", "audience": "user" },
          { "name": "portalVersionHistory", "description": "读取 Portal 聚合已确认的版本历史", "audience": "user" },
          { "name": "readPortalVersion", "description": "冷读一个精确 Portal 历史版本", "audience": "user" },
          { "name": "comparePortalVersions", "description": "比较两个兼容环境修订的 Portal 版本", "audience": "user" },
          { "name": "restorePortalVersion", "description": "从历史版本覆盖当前 WorkingCopy", "audience": "user" },
          { "name": "rollbackPortalRelease", "description": "从历史版本创建新的 Portal 上线记录", "audience": "user" },
          { "name": "listTestTargetBindings", "description": "列出 Frontend 测试目标绑定", "audience": "user" },
          { "name": "putTestTargetBinding", "description": "CAS 保存 Frontend 应用插件测试目标", "audience": "user" },
          { "name": "listTestReleases", "description": "列出 Frontend Test Release", "audience": "user" },
          { "name": "createTestRelease", "description": "提交精确 Frontend 测试制品", "audience": "user" },
          { "name": "rollbackTestRelease", "description": "恢复中断的 Frontend Test Release", "audience": "user" },
          { "name": "audit", "description": "读取 revision 审计", "audience": "user" }
        ]
      }, {
        "id": "platform.portal-preference",
        "service_role": "backend",
        "title": "Portal 用户偏好",
        "subcommands": [
          { "name": "get", "description": "读取当前主体的 Portal 偏好" },
          { "name": "put", "description": "以 CAS 保存当前主体的 Portal 偏好" }
        ]
      }]
    },
    "frontend": {
      "views": [{ "id": "platform.portal-composer", "title": "门户与插件组合" }],
      "navigations": [{ "id": "main", "contract": "1.0.0", "nodes": [
        { "id": "portal-management", "zone": "settings", "label": { "key": "navigation.portal-management", "fallback": "Portal 管理" }, "icon": { "kind": "semantic", "name": "portal" }, "order": 90 }
      ], "icons": [] }]
    }
  }
}
