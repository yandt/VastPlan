{
  "id": "cn.vastplan.platform.configuration.portal-composer",
  "name": "VastPlan Portal Composer",
  "description": "治理 Platform Profile、Portal 输入、不可变 Activation 与用户级 PortalPreference",
  "version": "1.8.0",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "engines": { "backend": "^0.1", "frontend": "^1.0" },
  "capabilities": { "kernelServices": ["kernel.config.get", "kernel.portal.catalog.validate", "kernel.portal.catalog.materialize", "kernel.portal.artifact-references.publish", "kernel.portal.test-artifact.validate", "kernel.state.shared.get", "kernel.state.shared.create", "kernel.state.shared.update"], "credentials": [], "resources": [] },
  "contextAccess": { "required": ["scope.tenant", "caller", "subject.id"], "optional": ["scene", "trace", "request.deadline", "request.idempotency", "propagation.callPath"] },
  "authorization": {
    "namespace": "platform.portal",
    "capabilities": ["platform.portal-composer"],
    "permissions": [
      { "code": "platform.portal.read", "title": "查看 Portal 治理", "scope": "platform", "risk": "low", "assignable": true, "offlineAllowed": false },
      { "code": "platform.portal.compose", "title": "编辑 Portal 组合草稿", "scope": "platform", "risk": "high", "assignable": true, "offlineAllowed": false },
      { "code": "platform.portal.approve", "title": "审批 Portal 组合", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false },
      { "code": "platform.portal.publish", "title": "发布或回滚 Portal 组合", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false }
    ],
    "operationGuards": [
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "governance", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "list", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "audit", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "listActivations", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "listTestTargetBindings", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "listTestReleases", "permissions": ["platform.portal.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "createDraft", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "updateDraft", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "submit", "permissions": ["platform.portal.compose"], "access": "execute", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "createProfileDraft", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "updateProfileDraft", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "deleteProfileDraft", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "submitProfile", "permissions": ["platform.portal.compose"], "access": "execute", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "createBindingDraft", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "updateBindingDraft", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "submitBinding", "permissions": ["platform.portal.compose"], "access": "execute", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "putTestTargetBinding", "permissions": ["platform.portal.compose"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "approve", "permissions": ["platform.portal.approve"], "access": "approve", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "approveProfile", "permissions": ["platform.portal.approve"], "access": "approve", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "approveBinding", "permissions": ["platform.portal.approve"], "access": "approve", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "publish", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "publishProfile", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "publishBinding", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "activate", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "rollbackActivation", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "createTestRelease", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "operation": "rollbackTestRelease", "permissions": ["platform.portal.publish"], "access": "execute", "approval": "different-subject" }
    ]
  },
  "runtime": {
    "instancePolicy": "active-active",
    "stateModel": "external-shared",
    "visibility": "cluster",
    "routing": "queue",
    "routingDomain": "platform",
    "provides": [
      { "extensionPoint": "tool.package", "capability": "platform.portal-composer", "visibility": "cluster", "routing": "queue", "routingDomain": "platform" },
      { "extensionPoint": "tool.package", "capability": "platform.portal-preference", "visibility": "cluster", "routing": "queue", "routingDomain": "platform" }
    ]
  },
  "execution": { "backend": { "driver": "native", "minimumIsolation": "trusted-process" } },
  "state": { "backend": { "format": "cn.vastplan.platform.portal-composer.shared", "formatVersion": 1 } },
  "activation": ["onStartup", "onPortalStartup"],
  "entry": { "backend": "backend/portal-composer", "frontend": "frontend/dist/index.js" },
  "contributes": {
    "backend": {
      "tools": [{
        "id": "platform.portal-composer",
        "service_role": "backend",
        "title": "门户组合治理",
        "subcommands": [
          { "name": "governance", "description": "读取完整 Portal 治理工作区", "audience": "user" },
          { "name": "createDraft", "description": "创建 Application 草稿", "audience": "user" },
          { "name": "updateDraft", "description": "更新 Application 草稿", "audience": "user" },
          { "name": "list", "description": "列出 Application revisions", "audience": "user" },
          { "name": "submit", "description": "提交 Application 审批", "audience": "user" },
          { "name": "approve", "description": "审批 Application", "audience": "user" },
          { "name": "publish", "description": "发布 Application 输入", "audience": "user" },
          { "name": "createProfileDraft", "description": "创建 Profile 草稿", "audience": "user" },
          { "name": "updateProfileDraft", "description": "更新 Profile 草稿", "audience": "user" },
          { "name": "deleteProfileDraft", "description": "删除 Profile 草稿", "audience": "user" },
          { "name": "submitProfile", "description": "提交 Profile 审批", "audience": "user" },
          { "name": "approveProfile", "description": "审批 Profile", "audience": "user" },
          { "name": "publishProfile", "description": "发布 Profile", "audience": "user" },
          { "name": "createBindingDraft", "description": "创建 Binding 草稿", "audience": "user" },
          { "name": "updateBindingDraft", "description": "更新 Binding 草稿", "audience": "user" },
          { "name": "submitBinding", "description": "提交 Binding 审批", "audience": "user" },
          { "name": "approveBinding", "description": "审批 Binding", "audience": "user" },
          { "name": "publishBinding", "description": "发布 Binding", "audience": "user" },
          { "name": "activate", "description": "CAS 激活 Published 输入", "audience": "user" },
          { "name": "rollbackActivation", "description": "由历史 Activation 创建新激活", "audience": "user" },
          { "name": "listActivations", "description": "列出不可变 Activation", "audience": "user" },
          { "name": "listTestTargetBindings", "description": "列出 Frontend 测试目标绑定", "audience": "user" },
          { "name": "putTestTargetBinding", "description": "CAS 保存 Frontend 应用插件测试目标", "audience": "user" },
          { "name": "listTestReleases", "description": "列出 Frontend Test Release", "audience": "user" },
          { "name": "createTestRelease", "description": "提交精确 Frontend 测试制品", "audience": "user" },
          { "name": "rollbackTestRelease", "description": "恢复中断的 Frontend Test Release", "audience": "user" },
          { "name": "audit", "description": "读取 revision 审计", "audience": "user" }
        ]
      }, {
        "id": "platform.portal-preference",
        "service_role": "backend",
        "title": "Portal 用户偏好",
        "subcommands": [
          { "name": "get", "description": "读取当前主体的 Portal 偏好" },
          { "name": "put", "description": "以 CAS 保存当前主体的 Portal 偏好" }
        ]
      }]
    },
    "frontend": {
      "views": [{ "id": "platform.portal-composer", "title": "门户与插件组合" }],
      "menus": [{ "id": "platform.portal-composer.menu", "title": "系统配置" }]
    }
  }
}
