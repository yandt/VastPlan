{
  "id": "cn.vastplan.platform.infrastructure.composition-planner",
  "name": "VastPlan 应用组合规划器",
  "version": "0.2.6",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "description": "把用户 Application Intent 编译为确定、可解释且可复验的 Backend 组合方案",
  "engines": { "backend": "^0.1" },
  "capabilities": { "kernelServices": [], "credentials": [], "resources": [] },
  "contextAccess": { "required": ["scope.tenant", "caller"], "optional": ["trace", "request.deadline", "propagation.callPath"] },
  "configuration": {
    "scope": "service",
    "applyMode": "restart",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "kernelVersion", "allowedChannels", "allowedPublishers"],
      "properties": {
        "channel": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kernelVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
        "platform": { "type": "string", "pattern": "^[a-z0-9]+/[a-z0-9_]+$" },
        "allowedChannels": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" } },
        "allowedPublishers": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" } },
        "allowedPluginPrefixes": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" } },
        "allowDevelopmentPlugins": { "type": "boolean", "default": false }
      }
    }
  },
  "runtime": {
    "instancePolicy": "active-active",
    "stateModel": "external-shared",
    "visibility": "cluster",
    "routing": "queue",
    "routingDomain": "platform",
    "requires": [
      { "capability": "platform.artifacts.repository", "scope": "remote", "kind": "strong", "ready": "readiness", "failurePolicy": "fail", "logicalService": "platform.artifacts.repository", "routingDomain": "platform" }
    ],
    "provides": [
      { "extensionPoint": "tool.package", "capability": "platform.composition.plan", "visibility": "cluster", "routing": "queue", "routingDomain": "platform" }
    ]
  },
  "execution": { "backend": { "driver": "native", "minimumIsolation": "trusted-process" } },
  "activation": ["onStartup"],
  "entry": { "backend": "backend/composition-planner" },
  "contributes": {
    "backend": {
      "tools": [{
        "id": "platform.composition.plan",
        "service_role": "backend",
        "title": "应用组合规划器",
        "subcommands": [{
          "name": "plan",
          "description": "把 Application Intent 编译为可解释的只读组合方案",
          "paramsSchema": { "type": "object", "additionalProperties": false, "required": ["intent", "platformProfile"], "properties": { "intent": { "type": "object" }, "platformProfile": { "type": "object" }, "configurationSnapshot": { "type": "object" } } },
          "resultSchema": { "type": "object" }
        }]
      }]
    }
  }
}
