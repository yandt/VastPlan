{
  "id": "cn.vastplan.platform.infrastructure.deployment-manager",
  "name": "VastPlan 部署与测试发布管理服务",
  "version": "0.26.0",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "description": "管理非敏感节点引导、跨服务插件安装候选、应用服务修订和 Backend 测试发布；凭证、制品信任、KV 与就绪事实仍由可信内核持有",
  "engines": { "backend": "^0.1", "frontend": "^1.0" },
  "capabilities": { "kernelServices": ["kernel.node.bootstrap", "kernel.node.readiness", "kernel.deployment.targets", "kernel.deployment.preview", "kernel.deployment.publish", "kernel.deployment.readiness", "kernel.platform-profile.prepare", "kernel.platform-profile.status", "kernel.platform-profile.activate", "kernel.platform-profile.publish", "kernel.platform-profile.finalize", "kernel.platform-profile.abort", "kernel.platform-profile.rollback", "kernel.state.shared.get", "kernel.state.shared.create", "kernel.state.shared.update"], "credentials": [], "resources": [] },
  "contextAccess": { "required": ["scope.tenant", "caller", "subject.id", "authorization.roles"], "optional": ["scope.project", "scene", "trace", "request.deadline", "request.idempotency", "propagation.callPath"] },
  "authorization": {
    "namespace": "platform.deployment",
    "permissions": [
      { "code": "platform.deployment.read", "title": "查看服务与节点", "scope": "platform", "risk": "low", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.write", "title": "维护节点计划", "scope": "platform", "risk": "high", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.bootstrap", "title": "申请节点引导", "scope": "platform", "risk": "high", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.approve", "title": "审批部署变更", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.compose", "title": "编辑服务组合", "scope": "platform", "risk": "high", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.plugin.preview", "title": "预览服务插件安装", "scope": "platform", "risk": "low", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.plugin.request", "title": "申请服务插件变更", "scope": "platform", "risk": "high", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.plugin.approve", "title": "审批服务插件变更", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.plugin.activate", "title": "激活或回滚服务插件变更", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.publish", "title": "发布或回滚服务", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false },
      { "code": "platform.deployment.test-target", "title": "管理测试发布目标", "scope": "platform", "risk": "critical", "assignable": true, "offlineAllowed": false }
    ],
    "operationGuards": [
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listNodes", "permissions": ["platform.deployment.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listBootstrapJobs", "permissions": ["platform.deployment.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listDeploymentTargets", "permissions": ["platform.deployment.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listServiceRevisions", "permissions": ["platform.deployment.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "previewPluginInstallation", "permissions": ["platform.deployment.plugin.preview"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "previewSelfServicePluginInstallation", "permissions": ["platform.deployment.plugin.preview"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listPluginInstallationTargets", "permissions": ["platform.deployment.plugin.preview"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listPluginInstallationCandidates", "permissions": ["platform.deployment.plugin.preview"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "getPluginInstallationCandidate", "permissions": ["platform.deployment.plugin.preview"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listSelfServicePluginInstallationCandidates", "permissions": ["platform.deployment.plugin.preview"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "getSelfServicePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.preview"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "createPluginInstallationCandidate", "permissions": ["platform.deployment.plugin.request"], "access": "write", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "createSelfServicePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.request"], "access": "write", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "submitPluginInstallationCandidate", "permissions": ["platform.deployment.plugin.request"], "access": "write", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "cancelPluginInstallationCandidate", "permissions": ["platform.deployment.plugin.request"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "approvePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.approve"], "access": "approve", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "activatePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.activate"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "rollbackPluginInstallationCandidate", "permissions": ["platform.deployment.plugin.activate"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "submitSelfServicePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.request"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "cancelSelfServicePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.request"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "approveSelfServicePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.approve"], "access": "approve", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "activateSelfServicePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.activate"], "access": "execute", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "rollbackSelfServicePluginInstallationCandidate", "permissions": ["platform.deployment.plugin.activate"], "access": "execute", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listServiceRevisionAudit", "permissions": ["platform.deployment.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listTestTargetBindings", "permissions": ["platform.deployment.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "listTestReleases", "permissions": ["platform.deployment.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "putNode", "permissions": ["platform.deployment.write"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "createBootstrap", "permissions": ["platform.deployment.bootstrap"], "access": "write", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "approveBootstrap", "permissions": ["platform.deployment.approve"], "access": "approve", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "createIntentDraft", "permissions": ["platform.deployment.compose"], "access": "write", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "updateIntentDraft", "permissions": ["platform.deployment.compose"], "access": "write", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "refreshIntentDraft", "permissions": ["platform.deployment.compose"], "access": "write", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "submitServiceDraft", "permissions": ["platform.deployment.compose"], "access": "write", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "approveServiceRevision", "permissions": ["platform.deployment.approve"], "access": "approve", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "publishServiceRevision", "permissions": ["platform.deployment.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "rollbackServiceRevision", "permissions": ["platform.deployment.publish"], "access": "execute", "approval": "different-subject" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "putTestTargetBinding", "permissions": ["platform.deployment.test-target"], "access": "write", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "createTestRelease", "permissions": ["platform.deployment.publish"], "access": "execute", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.deployment", "operation": "rollbackTestRelease", "permissions": ["platform.deployment.publish"], "access": "execute", "approval": "none" }
    ]
  },
  "runtime": {
    "instancePolicy": "leader",
    "stateModel": "external-shared",
    "visibility": "cluster",
    "routing": "leader",
    "routingDomain": "platform",
    "requires": [
      { "capability": "platform.settings", "scope": "remote", "kind": "strong", "ready": "readiness", "failurePolicy": "fail", "logicalService": "platform.settings", "routingDomain": "platform" },
      { "capability": "platform.credentials", "scope": "remote", "kind": "strong", "ready": "readiness", "failurePolicy": "fail", "logicalService": "platform.credentials", "routingDomain": "platform" },
      { "capability": "platform.artifacts.repository", "scope": "remote", "kind": "strong", "ready": "readiness", "failurePolicy": "fail", "logicalService": "platform.artifacts.repository", "routingDomain": "platform" },
      { "capability": "platform.composition.plan", "scope": "remote", "kind": "soft", "ready": "readiness", "failurePolicy": "degrade", "logicalService": "platform.composition.plan", "routingDomain": "platform" }
    ],
    "provides": [{ "extensionPoint": "tool.package", "capability": "platform.deployment", "visibility": "cluster", "routing": "leader", "routingDomain": "platform" }]
  },
  "execution": { "backend": { "driver": "native", "minimumIsolation": "trusted-process" } },
  "configuration": {
    "scope": "service", "applyMode": "restart",
    "schema": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "pluginInstallationApprovalPolicy": {
          "type": "object", "additionalProperties": false, "required": ["protocol", "capability", "logicalService", "routingDomain", "profile"],
          "properties": {
            "protocol": { "const": "approval.policy.v2" },
            "capability": { "const": "foundation.security.approval-policy" },
            "logicalService": { "type": "string", "minLength": 1, "maxLength": 160 },
            "routingDomain": { "type": "string", "minLength": 1, "maxLength": 160 },
            "profile": {
              "type": "object", "additionalProperties": false, "required": ["id", "revision", "digest"],
              "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 160 }, "revision": { "type": "integer", "minimum": 1 }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
            }
          }
        }
      }
    }
  },
  "state": { "backend": { "format": "cn.vastplan.platform.deployment-manager.shared", "formatVersion": 1 } },
  "activation": ["onStartup", "onPortalStartup"],
  "entry": { "backend": "backend/deployment-manager", "frontend": "frontend/dist/index.js" },
  "contributes": {
    "backend": {
      "tools": [{
        "id": "platform.deployment",
        "service_role": "backend",
        "title": "部署与测试发布管理",
        "subcommands": [
          { "name": "listNodes", "description": "列出当前租户的节点计划", "paramsSchema": { "type": "object", "properties": {} } },
          { "name": "putNode", "description": "以 CAS 保存不含明文凭证的节点计划", "paramsSchema": { "type": "object", "properties": { "id": { "type": "string" }, "plan": { "type": "object" }, "ifVersion": { "type": "integer", "minimum": 0 } }, "required": ["id", "plan"] } },
          { "name": "listBootstrapJobs", "description": "列出首次引导审批作业", "paramsSchema": { "type": "object", "properties": {} } },
          { "name": "createBootstrap", "description": "申请指定节点的首次引导", "paramsSchema": { "type": "object", "properties": { "nodeId": { "type": "string" } }, "required": ["nodeId"] } },
          { "name": "approveBootstrap", "description": "由不同审批人批准并触发可信内核引导", "paramsSchema": { "type": "object", "properties": { "jobId": { "type": "string" } }, "required": ["jobId"] } },
          { "name": "listDeploymentTargets", "description": "列出平台预授权的部署目标", "paramsSchema": { "type": "object", "properties": {} } },
          { "name": "listServiceRevisions", "description": "列出服务组合修订", "paramsSchema": { "type": "object", "properties": {} } },
          { "name": "previewPluginInstallation", "description": "按可信来源预览应用插件安装、升级或卸载影响", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "installationPreview": { "type": "object" } }, "required": ["installationPreview"] } },
          { "name": "previewSelfServicePluginInstallation", "description": "由 Portal 管理绑定为当前服务预览应用插件变更", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "installationPreview": { "type": "object" } }, "required": ["installationPreview"] } },
          { "name": "previewDevelopmentPluginInstallation", "description": "由受信开发控制器为显式绑定目标预览插件变更", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "installationPreview": { "type": "object" } }, "required": ["installationPreview"] } },
          { "name": "createPluginInstallationCandidate", "description": "从控制器入口创建持久插件安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "installationPreview": { "type": "object" } }, "required": ["installationPreview"] } },
          { "name": "createSelfServicePluginInstallationCandidate", "description": "从服务自助入口创建持久插件安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "installationPreview": { "type": "object" } }, "required": ["installationPreview"] } },
          { "name": "createDevelopmentPluginInstallationCandidate", "description": "从开发入口创建持久插件安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "installationPreview": { "type": "object" } }, "required": ["installationPreview"] } },
          { "name": "listPluginInstallationTargets", "description": "列出控制器获授权的最小逻辑服务安装目标", "paramsSchema": { "type": "object", "properties": {} } },
          { "name": "listPluginInstallationCandidates", "description": "列出插件安装候选及派生状态", "paramsSchema": { "type": "object", "properties": {} } },
          { "name": "getPluginInstallationCandidate", "description": "读取一个插件安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "listSelfServicePluginInstallationCandidates", "description": "只列出 ManagementTarget 绑定服务的自助安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "installationTarget": { "type": "object" } }, "required": ["installationTarget"] } },
          { "name": "getSelfServicePluginInstallationCandidate", "description": "读取 ManagementTarget 绑定服务的一个自助安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" }, "installationTarget": { "type": "object" } }, "required": ["candidateId", "installationTarget"] } },
          { "name": "submitPluginInstallationCandidate", "description": "重新规划并提交插件安装候选审批", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "approvePluginInstallationCandidate", "description": "由不同主体批准插件安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "activatePluginInstallationCandidate", "description": "通过既有可信发布链激活插件安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "cancelPluginInstallationCandidate", "description": "取消尚未提交的插件安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "rollbackPluginInstallationCandidate", "description": "以新的服务修订回滚已激活安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "submitSelfServicePluginInstallationCandidate", "description": "重新规划并提交绑定服务的自助安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" }, "installationTarget": { "type": "object" } }, "required": ["candidateId", "installationTarget"] } },
          { "name": "approveSelfServicePluginInstallationCandidate", "description": "按审批策略批准绑定服务的自助安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" }, "installationTarget": { "type": "object" }, "approvalEvidence": { "type": "object", "maxProperties": 32 } }, "required": ["candidateId", "installationTarget"] } },
          { "name": "activateSelfServicePluginInstallationCandidate", "description": "激活绑定服务的自助安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" }, "installationTarget": { "type": "object" } }, "required": ["candidateId", "installationTarget"] } },
          { "name": "cancelSelfServicePluginInstallationCandidate", "description": "取消绑定服务尚未提交的自助安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" }, "installationTarget": { "type": "object" } }, "required": ["candidateId", "installationTarget"] } },
          { "name": "rollbackSelfServicePluginInstallationCandidate", "description": "回滚绑定服务已激活的自助安装候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" }, "installationTarget": { "type": "object" } }, "required": ["candidateId", "installationTarget"] } },
          { "name": "createIntentDraft", "description": "创建 Application Intent 规划草稿", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "intent": { "type": "object" } }, "required": ["intent"] } },
          { "name": "updateIntentDraft", "description": "更新 Application Intent 并重建计划快照", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "revisionId": { "type": "integer", "minimum": 1 }, "intent": { "type": "object" } }, "required": ["revisionId", "intent"] } },
          { "name": "refreshIntentDraft", "description": "显式接受最新 Planner 结果并清除 stale", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "revisionId": { "type": "integer", "minimum": 1 } }, "required": ["revisionId"] } },
          { "name": "bindIntentConfiguration", "description": "由可信配置协调器绑定 CredentialRef 快照", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "revisionId": { "type": "integer", "minimum": 1 }, "configurationSnapshot": { "type": "object" } }, "required": ["revisionId", "configurationSnapshot"] } },
          { "name": "submitServiceDraft", "description": "提交服务组合审批", "paramsSchema": { "type": "object", "properties": { "revisionId": { "type": "integer", "minimum": 1 } }, "required": ["revisionId"] } },
          { "name": "approveServiceRevision", "description": "批准服务组合修订", "paramsSchema": { "type": "object", "properties": { "revisionId": { "type": "integer", "minimum": 1 } }, "required": ["revisionId"] } },
          { "name": "publishServiceRevision", "description": "通过可信内核发布服务组合", "paramsSchema": { "type": "object", "properties": { "revisionId": { "type": "integer", "minimum": 1 } }, "required": ["revisionId"] } },
          { "name": "rollbackServiceRevision", "description": "以新修订回滚到历史服务组合", "paramsSchema": { "type": "object", "properties": { "revisionId": { "type": "integer", "minimum": 1 } }, "required": ["revisionId"] } },
          { "name": "createConfigurationActivation", "description": "从活动可信目录创建应用插件配置审批修订", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "activation": { "type": "object" } }, "required": ["activation"] } },
          { "name": "getConfigurationActivation", "description": "按配置候选读取外部发布与就绪状态", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "publishConfigurationActivation", "description": "发布已审批配置修订并在 readiness 失败时单调回滚", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "createProfileConfigurationActivation", "description": "从活动可信目录创建 Platform Profile 配置审批候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "profileActivation": { "type": "object" } }, "required": ["profileActivation"] } },
          { "name": "getProfileConfigurationActivation", "description": "读取 Platform Profile 配置激活状态", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "approveProfileConfigurationActivation", "description": "由不同主体批准 Platform Profile 配置激活", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "publishProfileConfigurationActivation", "description": "执行可恢复的 Catalog、Deployment 与 readiness 激活 Saga", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
          { "name": "abortProfileConfigurationActivation", "description": "放弃尚未激活的 Platform Profile 配置候选", "paramsSchema": { "type": "object", "additionalProperties": false, "properties": { "candidateId": { "type": "string" } }, "required": ["candidateId"] } },
