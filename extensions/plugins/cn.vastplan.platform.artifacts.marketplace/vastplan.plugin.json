{
  "id": "cn.vastplan.platform.artifacts.marketplace",
  "name": "VastPlan 插件市场",
  "version": "0.1.0",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "description": "以受治理 Profile 聚合多个自定义 URL 插件市场，凭证只通过可信 material lease 使用，制品仍须进入本地受信仓库和统一安装候选链",
  "engines": { "backend": "^0.1", "frontend": "^1.0" },
  "capabilities": { "kernelServices": ["kernel.credential.material-lease"], "credentials": [], "resources": [] },
  "contextAccess": { "required": ["scope.tenant"], "optional": ["caller", "trace", "request.deadline", "propagation.callPath"] },
  "authorization": {
    "namespace": "platform.artifacts.marketplace",
    "permissions": [
      { "code": "platform.artifacts.marketplace.read", "title": "浏览插件市场", "description": "查看平台配置的市场来源和插件目录", "scope": "platform", "risk": "low", "assignable": true, "offlineAllowed": false }
    ],
    "operationGuards": [
      { "extensionPoint": "tool.package", "capability": "platform.artifacts.marketplace", "operation": "listSources", "permissions": ["platform.artifacts.marketplace.read"], "access": "read", "approval": "none" },
      { "extensionPoint": "tool.package", "capability": "platform.artifacts.marketplace", "operation": "listCatalog", "permissions": ["platform.artifacts.marketplace.read"], "access": "read", "approval": "none" }
    ]
  },
  "runtime": {
    "instancePolicy": "active-active", "stateModel": "external-shared", "visibility": "cluster", "routing": "queue", "routingDomain": "platform",
    "provides": [{ "extensionPoint": "tool.package", "capability": "platform.artifacts.marketplace", "visibility": "cluster", "routing": "queue", "routingDomain": "platform" }],
    "requires": [{ "capability": "platform.artifacts.repository", "scope": "remote", "kind": "soft", "ready": "readiness", "failurePolicy": "degrade", "logicalService": "platform.artifacts.repository", "routingDomain": "platform" }]
  },
  "execution": { "backend": { "driver": "native", "minimumIsolation": "trusted-process" } },
  "configuration": {
    "scope": "service", "applyMode": "restart",
    "schema": {
      "type": "object", "additionalProperties": false, "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "label", "url", "priority"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 160 },
              "url": { "type": "string", "minLength": 8, "maxLength": 2048 },
              "priority": { "type": "integer", "minimum": 0, "maximum": 10000 },
              "allowInsecureLoopback": { "type": "boolean", "default": false },
              "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 60, "default": 8 },
              "credentialRef": { "type": "object" }
            }
          }
        }
      }
    }
  },
  "activation": ["onStartup", "onPortalStartup"],
  "entry": { "backend": "backend/plugin-marketplace", "frontend": "frontend/dist/index.js" },
  "contributes": {
    "backend": { "tools": [{ "id": "platform.artifacts.marketplace", "service_role": "backend", "title": "插件市场", "subcommands": [{ "name": "listSources", "description": "列出受治理市场来源" }, { "name": "listCatalog", "description": "查询一个受治理市场目录" }] }] },
    "frontend": { "views": [{ "id": "platform.service-plugin-marketplace", "title": "服务插件市场" }, { "id": "platform.service-plugin-tasks", "title": "安装任务" }], "menus": [{ "id": "platform.service-plugin-marketplace.menu", "title": "服务插件市场" }, { "id": "platform.service-plugin-tasks.menu", "title": "安装任务" }] }
  }
}
