{
  "id": "cn.vastplan.foundation.frontend.identity.account-center",
  "name": "VastPlan 个人中心",
  "description": "以标准 Portal 页面契约提供用户信息、用户设置和本地外观管理",
  "version": "0.7.1",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "engines": { "frontend": "^1.0" },
  "capabilities": { "kernelServices": [], "credentials": [], "resources": [] },
  "activation": ["onPortalStartup"],
  "entry": { "frontend": "frontend/dist/index.js" },
  "extensionPoints": [{
    "id": "cn.vastplan.foundation.frontend.identity.account-center.page",
    "surface": "frontend",
    "contract": "1.0.0",
    "kind": "frontend.page",
    "dispatch": "mount",
    "targets": ["profile", "preferences"],
    "descriptorSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageId", "groupId"],
      "properties": {
        "pageId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 160 },
        "groupId": { "enum": ["profile", "preferences"] }
      }
    }
  }],
  "contributes": {
    "frontend": {
      "views": [
        { "id": "account.profile", "title": "用户信息" },
        { "id": "account.settings.appearance", "title": "外观" }
      ],
      "navigations": [{ "id": "main", "contract": "1.0.0", "nodes": [
        { "id": "profile", "zone": "secondary", "label": { "key": "navigation.profile", "fallback": "用户信息" }, "icon": { "kind": "semantic", "name": "user" }, "parent": { "pluginId": "vastplan.host", "nodeId": "account", "mode": "required" }, "order": 10 },
        { "id": "preferences", "zone": "secondary", "label": { "key": "navigation.preferences", "fallback": "偏好设置" }, "icon": { "kind": "semantic", "name": "sliders" }, "parent": { "pluginId": "vastplan.host", "nodeId": "account", "mode": "required" }, "order": 20 }
      ], "icons": [] }]
    }
  }
}
