{
  "id": "cn.vastplan.platform.data.relational.connection-manager",
  "name": "VastPlan 数据库连接服务",
  "version": "0.16.3",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "description": "管理数据库连接与托管凭证，以按租户 Shared State CAS 和持久发布闭环驱动数据库运行服务",
  "engines": {
    "backend": "^0.1",
    "frontend": "^1.0"
  },
  "capabilities": {
    "kernelServices": [
      "kernel.platform-control.status",
      "kernel.platform-control.test",
      "kernel.platform-control.configure",
      "kernel.state.shared.get",
      "kernel.state.shared.fenced.create",
      "kernel.state.shared.fenced.update"
    ],
    "credentials": [],
    "resources": []
  },
  "contextAccess": {
    "required": [
      "scope.tenant",
      "caller"
    ],
    "optional": [
      "scene",
      "trace",
      "request.deadline",
      "request.idempotency",
      "propagation.callPath"
    ]
  },
  "authorization": {
    "browserExposed": true,
    "namespace": "platform.database",
    "permissions": [
      {
        "code": "platform.database.read",
        "title": "查看数据库连接定义",
        "scope": "platform",
        "risk": "high",
        "assignable": true,
        "offlineAllowed": false
      },
      {
        "code": "platform.database.write",
        "title": "管理数据库连接定义",
        "scope": "platform",
        "risk": "critical",
        "assignable": true,
        "offlineAllowed": false
      },
      {
        "code": "platform.database.probe",
        "title": "测试数据库连接",
        "scope": "platform",
        "risk": "critical",
        "assignable": true,
        "offlineAllowed": false
      }
    ],
    "operationGuards": [
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "describe",
        "permissions": [
          "platform.database.read"
        ],
        "access": "read",
        "approval": "none"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "list",
        "permissions": [
          "platform.database.read"
        ],
        "access": "read",
        "approval": "none"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "define",
        "permissions": [
          "platform.database.write"
        ],
        "access": "write",
        "approval": "none"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "remove",
        "permissions": [
          "platform.database.write"
        ],
        "access": "write",
        "approval": "none"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "probe",
        "permissions": [
          "platform.database.probe"
        ],
        "access": "execute",
        "approval": "none"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "test",
        "permissions": [
          "platform.database.probe"
        ],
        "access": "execute",
        "approval": "none"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "platformControlStatus",
        "permissions": [
          "platform.database.read"
        ],
        "access": "read",
        "approval": "none"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "platformControlTest",
        "permissions": [
          "platform.database.probe"
        ],
        "access": "execute",
        "approval": "none"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "operation": "platformControlConfigure",
        "permissions": [
          "platform.database.write"
        ],
        "access": "write",
        "approval": "none"
      }
    ]
  },
  "runtime": {
    "instancePolicy": "leader",
    "stateModel": "external-shared",
    "visibility": "cluster",
    "routing": "leader",
    "routingDomain": "platform",
    "requires": [
      {
        "capability": "platform.credentials",
        "contractRange": "^1.0.0",
        "scope": "remote",
        "kind": "lazy",
        "ready": "readiness",
        "failurePolicy": "degrade",
        "logicalService": "platform.credentials",
        "routingDomain": "platform"
      },
      {
        "capability": "foundation.data.relational.runtime",
        "contractRange": "^1.3.0",
        "scope": "remote",
        "kind": "lazy",
        "ready": "readiness",
        "failurePolicy": "degrade",
        "logicalService": "foundation.data.relational.runtime",
        "routingDomain": "platform"
      }
    ],
    "provides": [
      {
        "extensionPoint": "tool.package",
        "capability": "platform.database",
        "contractVersion": "1.2.0",
        "visibility": "cluster",
        "routing": "leader",
        "routingDomain": "platform"
      }
    ]
  },
  "execution": {
    "backend": {
      "driver": "native",
      "minimumIsolation": "trusted-process"
    }
  },
  "state": {
    "backend": {
      "format": "cn.vastplan.platform.database.connections",
      "formatVersion": 3
    }
  },
  "activation": [
    "onStartup",
    "onPortalStartup"
  ],
  "entry": {
    "backend": "backend/connection-manager",
    "frontend": "frontend/dist/index.js"
  },
  "contributes": {
    "backend": {
      "dataModels": [
        {
          "id": "platform.database.connection",
          "contractVersion": "1.1.0",
          "path": "data-models/database-connection.json",
          "sha256": "44ba1561d43100a3daa581a72f197e16270a65affd66ac4bdeb8004aa6ee1b92"
        }
      ],
      "tools": [
        {
          "id": "platform.database",
          "service_role": "backend",
          "title": "数据库连接",
          "subcommands": [
            {
              "name": "define",
              "description": "定义连接、数据库类型参数和连接池策略，并发布到数据库运行服务",
              "paramsSchema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "connection": {
                    "type": "object"
                  },
                  "credentialValue": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "connection"
                ]
              }
            },
            {
              "name": "describe",
              "description": "读取连接定义",
              "paramsSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "name": "list",
              "description": "列出连接定义",
              "paramsSchema": {
                "type": "object",
                "properties": {}
              }
            },
            {
              "name": "remove",
              "description": "删除连接定义",
              "paramsSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "name": "probe",
              "description": "由数据库运行服务使用托管凭证探测连接",
              "paramsSchema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            {
              "name": "test",
              "description": "使用当前表单值和短期托管凭证测试连接，不保存连接定义",
              "paramsSchema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "connection": {
                    "type": "object"
                  },
                  "credentialValue": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "connection"
                ]
              }
            },
            {
              "name": "platformControlStatus",
              "description": "读取平台控制数据库 Bootstrap 状态"
            },
            {
              "name": "platformControlTest",
              "description": "测试平台控制数据库候选配置"
            },
            {
              "name": "platformControlConfigure",
              "description": "初始化并提交平台控制数据库候选配置"
            }
          ]
        }
      ]
    },
    "frontend": {
      "views": [
        {
          "id": "platform.database-connections",
          "title": "数据库连接"
        }
      ],
      "navigations": [
        {
          "id": "main",
          "contract": "1.0.0",
          "nodes": [
            {
              "id": "databases",
              "zone": "primary",
              "label": {
                "key": "navigation.databases",
                "fallback": "数据库连接"
              },
              "icon": {
                "kind": "semantic",
                "name": "database"
              },
              "order": 40
            }
          ],
          "icons": []
        }
      ]
    }
  }
}
