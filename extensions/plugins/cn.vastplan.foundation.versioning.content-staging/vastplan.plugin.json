{
  "id": "cn.vastplan.foundation.versioning.content-staging",
  "name": "VastPlan Version Content Staging",
  "version": "0.3.0",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "description": "提供绑定 Workspace Session 的内容暂存 Lease、持久版本内容引用、本地内容寻址存储、流式完整性校验与安全回收",
  "engines": { "backend": "^0.1" },
  "capabilities": { "kernelServices": [], "credentials": [], "resources": [] },
  "contextAccess": {
    "required": ["caller", "scope.tenant", "request.idempotency"],
    "optional": ["subject.id", "scope.project", "scene", "trace", "request.deadline", "propagation.callPath"]
  },
  "runtime": {
    "instancePolicy": "leader",
    "stateModel": "leader-owned",
    "visibility": "cluster",
    "routing": "leader",
    "routingDomain": "platform",
    "provides": [
      {
        "extensionPoint": "tool.package",
        "capability": "foundation.versioning.content-staging",
        "visibility": "cluster",
        "routing": "leader",
        "routingDomain": "platform"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "foundation.versioning.content-reference",
        "visibility": "cluster",
        "routing": "leader",
        "routingDomain": "platform"
      },
      {
        "extensionPoint": "tool.package",
        "capability": "foundation.versioning.content-upload",
        "visibility": "cluster",
        "routing": "leader",
        "routingDomain": "platform"
      }
    ],
    "requires": [
      {
        "capability": "platform.api-exposure",
        "scope": "remote",
        "kind": "soft",
        "ready": "readiness",
        "failurePolicy": "degrade",
        "logicalService": "platform.api-exposure",
        "routingDomain": "platform"
      }
    ]
  },
  "execution": { "backend": { "driver": "native", "minimumIsolation": "trusted-process" } },
  "configuration": {
    "scope": "service",
    "applyMode": "restart",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "limits", "reclaimIntervalSeconds"],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol", "root"],
          "properties": {
            "protocol": { "const": "version.staging.storage.file.v1" },
            "root": { "type": "string", "pattern": "^/", "maxLength": 4096 }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxFileBytes", "maxTenantBytes", "maxTotalBytes", "maxActiveUploadsPerTenant", "maxLeaseSeconds", "maxPreparedPerTenant", "preparedProtectionSeconds", "terminalRetentionSeconds"],
          "properties": {
            "maxFileBytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
            "maxTenantBytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
            "maxTotalBytes": { "type": "integer", "minimum": 1, "maximum": 1099511627776 },
            "maxActiveUploadsPerTenant": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxLeaseSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
            "maxPreparedPerTenant": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "preparedProtectionSeconds": { "type": "integer", "minimum": 300, "maximum": 604800 },
            "terminalRetentionSeconds": { "type": "integer", "minimum": 60, "maximum": 2592000 }
          }
        },
        "dataPlane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["listen", "endpoint", "instanceId", "tlsIdentity", "exposures"],
          "properties": {
            "listen": { "type": "string", "minLength": 1, "maxLength": 256 },
            "endpoint": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
            "instanceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
            "tlsIdentity": { "type": "string", "pattern": "^spiffe://", "maxLength": 512 },
            "allowedBrowserOrigins": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "exposures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tenantId", "exposureId"],
                "properties": {
                  "tenantId": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "exposureId": { "type": "string", "pattern": "^dpx_[a-z2-7]{20}$" }
                }
              }
            }
          }
        },
        "reclaimIntervalSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 }
      }
    }
  },
  "activation": ["onStartup"],
  "entry": { "backend": "backend/content-staging" },
  "contributes": {
    "backend": {
      "tools": [
        {
          "id": "foundation.versioning.content-staging",
          "service_role": "backend",
          "title": "Version Content Staging",
          "subcommands": [
            { "name": "beginUpload", "description": "为可信 Workspace 创建绑定 Session 的上传 Lease" },
            { "name": "uploadStatus", "description": "读取上传状态和接收进度" },
            { "name": "renewUpload", "description": "以 CAS 续租临时内容保护" },
            { "name": "completeUpload", "description": "封闭输入并校验摘要、大小与安全准入" },
            { "name": "abortUpload", "description": "以 CAS 终止上传并进入安全回收" }
          ]
        },
        {
          "id": "foundation.versioning.content-reference",
          "service_role": "backend",
          "title": "Version Content Reference",
          "subcommands": [
            { "name": "prepareVersion", "description": "在 Ledger 提交前持久保护 manifest 内容" },
            { "name": "protectionStatus", "description": "读取持久保护状态" },
            { "name": "confirmVersion", "description": "将保护幂等确认给精确 VersionRef" },
            { "name": "abortProtection", "description": "显式终止未确认保护" }
          ]
        },
        {
          "id": "foundation.versioning.content-upload",
          "service_role": "backend",
          "title": "Version Content Upload",
          "subcommands": [
            { "name": "installDataPlaneTicket", "description": "安装 API Exposure 签发的一次性内容上传 Ticket" }
          ]
        }
      ],
      "dataPlaneServices": [
        {
          "id": "version-content-upload",
          "service_role": "backend",
          "title": "版本内容 HTTPS 流式上传数据面",
          "protocol": "https",
          "purposes": ["version-content-upload"],
          "supportedModes": ["ticket-redirect"],
          "healthPath": "/healthz",
          "maxObjectBytes": 1099511627776,
          "ticketTarget": { "capability": "foundation.versioning.content-upload", "operation": "installDataPlaneTicket" }
        }
      ]
    }
  }
}
