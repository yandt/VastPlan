{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cdsoft.com.cn/vastplan/composition/backend/v1/vastplan.resolution-report.schema.json",
  "title": "VastPlan Backend Resolution Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "intent", "platformProfile", "planner", "status", "features", "providerBindings", "serviceGraph", "configurationPlan", "diagnostics", "planDigest"],
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["Resolved", "NeedsConfiguration"] } }, "required": ["status"] },
      "then": { "required": ["applicationComposition", "applicationCompositionDigest", "artifactLock"] }
    },
    {
      "if": { "properties": { "status": { "const": "Invalid" } }, "required": ["status"] },
      "then": { "properties": { "diagnostics": { "minItems": 1 } } }
    }
  ],
  "properties": {
    "version": { "const": 1 },
    "intent": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/composition/common/v1/vastplan.composition-common.schema.json#/$defs/compositionRef" },
    "platformProfile": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/composition/common/v1/vastplan.composition-common.schema.json#/$defs/compositionRef" },
    "planner": { "$ref": "#/$defs/planner" },
    "status": { "enum": ["Resolved", "NeedsConfiguration", "Invalid"] },
    "applicationComposition": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/composition/backend/v1/vastplan.application-composition.schema.json" },
    "applicationCompositionDigest": { "$ref": "#/$defs/sha256" },
    "artifactLock": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/plugin/v1/vastplan.artifact-lock.schema.json" },
    "features": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/resolvedFeature" } },
    "providerBindings": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/providerBinding" } },
    "serviceGraph": { "$ref": "#/$defs/serviceGraph" },
    "configurationPlan": { "$ref": "#/$defs/configurationPlan" },
    "diagnostics": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/diagnostic" } },
    "planDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "serviceId": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
    "featureId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 80 },
    "artifactRef": {
      "type": "object", "additionalProperties": false, "required": ["pluginId", "version", "channel"],
      "properties": {
        "pluginId": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/common/v1/identifiers.schema.json#/$defs/pluginId" },
        "version": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/common/v1/identifiers.schema.json#/$defs/semver" },
        "channel": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/common/v1/identifiers.schema.json#/$defs/channel" }
      }
    },
    "planner": {
      "type": "object", "additionalProperties": false, "required": ["ref", "capability"],
      "properties": {
        "ref": { "$ref": "#/$defs/artifactRef" },
        "capability": { "const": "platform.composition.plan" }
      }
    },
    "resolvedFeature": {
      "type": "object", "additionalProperties": false, "required": ["unitId", "pluginId", "featureId"],
      "properties": {
        "unitId": { "$ref": "#/$defs/serviceId" },
        "pluginId": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/common/v1/identifiers.schema.json#/$defs/pluginId" },
        "featureId": { "$ref": "#/$defs/featureId" }
      }
    },
    "providerBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["consumerUnitId", "capability", "providerUnitId", "providerPluginId"],
      "properties": {
        "consumerUnitId": { "$ref": "#/$defs/serviceId" },
        "capability": { "type": "string", "minLength": 1, "maxLength": 160 },
        "providerUnitId": { "$ref": "#/$defs/serviceId" },
        "providerPluginId": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/common/v1/identifiers.schema.json#/$defs/pluginId" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "logicalService": { "type": "string", "minLength": 1, "maxLength": 160 },
        "routingDomain": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "serviceGraph": {
      "type": "object", "additionalProperties": false, "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/serviceNode" } },
        "edges": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/serviceEdge" } }
      }
    },
    "serviceNode": {
      "type": "object", "additionalProperties": false, "required": ["unitId", "serviceClass"],
      "properties": {
        "unitId": { "$ref": "#/$defs/serviceId" },
        "serviceClass": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" }
      }
    },
    "serviceEdge": {
      "type": "object", "additionalProperties": false, "required": ["fromUnitId", "toUnitId", "capability", "kind", "failurePolicy"],
      "properties": {
        "fromUnitId": { "$ref": "#/$defs/serviceId" },
        "toUnitId": { "$ref": "#/$defs/serviceId" },
        "capability": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["strong", "soft", "lazy", "data"] },
        "failurePolicy": { "enum": ["fail", "degrade", "retry"] }
      }
    },
    "configurationPlan": {
      "type": "object", "additionalProperties": false, "required": ["items", "digest"],
      "properties": {
        "items": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/configurationItem" } },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "configurationItem": {
      "type": "object", "additionalProperties": false,
      "required": ["unitId", "pluginId", "source", "editable", "schemaDigest", "configurationDigest", "dependencyPath"],
      "properties": {
        "unitId": { "$ref": "#/$defs/serviceId" },
        "pluginId": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/common/v1/identifiers.schema.json#/$defs/pluginId" },
        "source": { "enum": ["root", "package-dependency", "platform-provider", "foundation"] },
        "editable": { "type": "boolean" },
        "schemaDigest": { "$ref": "#/$defs/sha256" },
        "configurationDigest": { "$ref": "#/$defs/sha256" },
        "dependencyPath": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/common/v1/identifiers.schema.json#/$defs/pluginId" }
        },
        "missing": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/configurationRequirement" } }
      }
    },
    "configurationRequirement": {
      "type": "object", "additionalProperties": false, "required": ["kind", "field"],
      "properties": {
        "kind": { "enum": ["property", "managed-credential"] },
        "field": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 160 }
      }
    },
    "diagnostic": {
      "type": "object", "additionalProperties": false, "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["warning", "error"] },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 160 },
        "path": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
