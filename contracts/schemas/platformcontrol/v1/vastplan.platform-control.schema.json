{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cdsoft.com.cn/vastplan/platformcontrol/v1/vastplan.platform-control.schema.json",
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^\\S(?:.*\\S)?$" },
    "secretRef": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "enum": ["systemd-credential", "owner-file"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "systemd-credential" } } }, "then": { "required": ["name"] } },
        { "if": { "properties": { "kind": { "const": "owner-file" } } }, "then": { "required": ["path"] } }
      ]
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "generation", "connection", "schema", "secretRef", "contractRange"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "connection": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/database/v1/vastplan.database-runtime.schema.json#/$defs/connectionCandidate" },
        "schema": { "$ref": "#/$defs/text" },
        "secretRef": { "$ref": "#/$defs/secretRef" },
        "contractRange": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "status": {
      "type": "object", "additionalProperties": false, "required": ["phase"],
      "properties": {
        "phase": { "enum": ["unconfigured", "testing", "initializing", "ready", "recovery"] },
        "generation": { "type": "integer", "minimum": 1 },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 160 }
      }
    }
  }
}
