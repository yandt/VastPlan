{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cdsoft.com.cn/vastplan/version-workspace/v1/vastplan.version-workspace.schema.json",
  "title": "VastPlan Version Workspace v1",
  "$defs": {
    "session": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "id", "environmentId", "environmentDigest", "resource", "namespace", "adapter", "mode", "readOnly", "state", "revision", "createdAt", "leaseExpiresAt"],
      "properties": {
        "protocol": { "const": "version.workspace.v1" },
        "id": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "environmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "environmentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resource": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/resourceKey" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 128 },
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 128 },
        "mode": { "enum": ["snapshot", "overlay", "git"] },
        "readOnly": { "type": "boolean" },
        "baseRef": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRef" },
        "baseHead": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
        "targetHead": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
        "headRevision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["Clean", "Dirty", "Committing", "Committed", "Discarded", "Expired"] },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "leaseExpiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "openRequest": {
      "type": "object", "additionalProperties": false, "required": ["environmentId", "resource", "readOnly"],
      "properties": {
        "environmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "resource": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/resourceKey" },
        "requestedMode": { "enum": ["snapshot", "overlay", "git"] },
        "baseRef": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRef" },
        "baseHead": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
        "targetHead": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
        "readOnly": { "type": "boolean" },
        "leaseSeconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      }
    },
    "describeResourceRequest": {
      "type": "object", "additionalProperties": false, "required": ["environmentId", "resource"],
      "properties": {
        "environmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "resource": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/resourceKey" },
        "requestedMode": { "enum": ["snapshot", "overlay", "git"] }
      }
    },
    "sessionRequest": {
      "type": "object", "additionalProperties": false, "required": ["sessionId"],
      "properties": { "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" } }
    },
    "revisionRequest": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "expectedRevision"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "expectedRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "writeSnapshotRequest": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "expectedRevision", "snapshot"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "snapshot": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/snapshot" }
      }
    },
    "beginContentUploadRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["sessionId", "expectedRevision", "path", "mediaType", "expectedDigest", "expectedSize", "leaseSeconds"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "mediaType": { "type": "string", "minLength": 3, "maxLength": 255 },
        "expectedDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "expectedSize": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
        "leaseSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 }
      }
    },
    "contentUploadRequest": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "uploadId"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "uploadId": { "type": "string", "pattern": "^stg_[A-Za-z0-9_-]{16,96}$" }
      }
    },
    "contentUploadRevisionRequest": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "uploadId", "expectedUploadRevision"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "uploadId": { "type": "string", "pattern": "^stg_[A-Za-z0-9_-]{16,96}$" },
        "expectedUploadRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "renewContentUploadRequest": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "uploadId", "expectedUploadRevision", "leaseSeconds"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "uploadId": { "type": "string", "pattern": "^stg_[A-Za-z0-9_-]{16,96}$" },
        "expectedUploadRevision": { "type": "integer", "minimum": 1 },
        "leaseSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 }
      }
    },
    "commitRequest": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "expectedRevision", "operationId"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "operationId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,159}$" },
        "message": { "type": "string", "maxLength": 1024 },
        "labels": { "type": "object", "maxProperties": 16, "additionalProperties": { "type": "string", "maxLength": 256 } }
      }
    },
    "committedRequest": {
      "type": "object", "additionalProperties": false, "required": ["environmentId", "environmentDigest", "resource", "ref"],
      "properties": {
        "environmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "environmentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resource": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/resourceKey" },
        "requestedMode": { "enum": ["snapshot", "overlay", "git"] },
        "ref": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRef" }
      }
    },
    "compareCommittedRequest": {
      "type": "object", "additionalProperties": false, "required": ["environmentId", "environmentDigest", "resource", "left", "right"],
      "properties": {
        "environmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "environmentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resource": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/resourceKey" },
        "requestedMode": { "enum": ["snapshot", "overlay", "git"] },
        "left": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRef" },
        "right": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRef" }
      }
    },
    "renewRequest": {
      "type": "object", "additionalProperties": false, "required": ["sessionId", "expectedRevision", "leaseSeconds"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^ws_[A-Za-z0-9_-]{16,96}$" },
        "expectedRevision": { "type": "integer", "minimum": 1 },
        "leaseSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 }
      }
    },
    "sessionResult": {
      "type": "object", "additionalProperties": false, "required": ["session"],
      "properties": { "session": { "$ref": "#/$defs/session" } }
    },
    "contentUploadResult": {
      "type": "object", "additionalProperties": false, "required": ["session", "upload"],
      "properties": {
        "session": { "$ref": "#/$defs/session" },
        "upload": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-staging/v1/vastplan.version-staging.schema.json#/$defs/uploadStatusResult" }
      }
    },
    "snapshotResult": {
      "type": "object", "additionalProperties": false, "required": ["session", "snapshot", "digest"],
      "properties": {
        "session": { "$ref": "#/$defs/session" },
        "snapshot": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/snapshot" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "changeSummary": {
      "type": "object", "additionalProperties": false, "required": ["added", "modified", "removed", "total"],
      "properties": {
        "added": { "type": "integer", "minimum": 0 }, "modified": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 0 }
      }
    },
    "changesResult": {
      "type": "object", "additionalProperties": false, "required": ["session", "dirty", "diffAvailable", "summary"],
      "properties": {
        "session": { "$ref": "#/$defs/session" }, "dirty": { "type": "boolean" },
        "diffAvailable": { "type": "boolean" },
        "changedPaths": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "summary": { "$ref": "#/$defs/changeSummary" }
      }
    },
    "resourceResolution": {
      "type": "object", "additionalProperties": false,
      "required": ["environmentId", "environmentDigest", "resource", "namespace", "adapter", "mode"],
      "properties": {
        "environmentId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
        "environmentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "resource": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/resourceKey" },
        "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 128 },
        "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 128 },
        "mode": { "enum": ["snapshot", "overlay", "git"] }
      }
    },
    "resourceDescription": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution", "contentKind", "allowedModes", "defaultMode", "maxBytes", "secretPolicy", "capabilities"],
      "properties": {
        "resolution": { "$ref": "#/$defs/resourceResolution" },
        "contentKind": { "enum": ["json", "files"] },
        "allowedModes": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["snapshot", "overlay", "git"] } },
        "defaultMode": { "enum": ["snapshot", "overlay", "git"] },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "secretPolicy": { "enum": ["forbidden", "credential-refs-only"] },
        "capabilities": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/adapterCapabilities" }
      }
    },
    "committedSnapshotResult": {
      "type": "object", "additionalProperties": false, "required": ["resolution", "version", "snapshot", "digest"],
      "properties": {
        "resolution": { "$ref": "#/$defs/resourceResolution" },
        "version": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRecord" },
        "snapshot": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/version-resource/v1/vastplan.version-resource.schema.json#/$defs/snapshot" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "compareCommittedResult": {
      "type": "object", "additionalProperties": false,
      "required": ["resolution", "left", "right", "leftDigest", "rightDigest", "dirty", "diffAvailable", "summary"],
      "properties": {
        "resolution": { "$ref": "#/$defs/resourceResolution" },
        "left": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRef" },
        "right": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRef" },
        "leftDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rightDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dirty": { "type": "boolean" },
        "diffAvailable": { "type": "boolean" },
        "changedPaths": { "type": "array", "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "summary": { "$ref": "#/$defs/changeSummary" }
      }
    },
    "commitResult": {
      "type": "object", "additionalProperties": false, "required": ["session", "version"],
      "properties": {
        "session": { "$ref": "#/$defs/session" },
        "version": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/versionRecord" },
        "head": { "$ref": "https://schemas.cdsoft.com.cn/vastplan/versioning/v1/vastplan.version-ledger.schema.json#/$defs/head" }
      }
    }
  }
}
