{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdsoft.com.cn/vastplan/schemas/recovery/v1/capsule.json",
  "title": "VastPlan Seed Recovery Capsule v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "inventory", "artifacts", "stages"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "generation"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256"],
        "properties": {
          "ref": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pluginId", "version", "channel"],
            "properties": {
              "pluginId": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "channel": { "type": "string", "minLength": 1 }
            }
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "units"],
        "properties": {
          "id": { "enum": ["recovery", "control-plane", "platform"] },
          "units": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
