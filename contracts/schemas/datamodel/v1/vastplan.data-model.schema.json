{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cdsoft.com.cn/vastplan/datamodel/v1/vastplan.data-model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "schemaVersion", "storage", "fields", "primaryKey", "indexes", "uniqueConstraints", "scope", "deletion"],
  "properties": {
    "contract": { "const": "data.model.v1" },
    "id": { "$ref": "#/$defs/id" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["kind", "table"],
      "properties": {
        "kind": { "enum": ["platform-control", "connection-ref"] },
        "table": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
      }
    },
    "fields": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/field" } },
    "primaryKey": { "$ref": "#/$defs/fieldSet" },
    "indexes": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/index" } },
    "uniqueConstraints": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/unique" } },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["tenant", "service"],
      "properties": { "tenant": { "$ref": "#/$defs/scopeMode" }, "service": { "$ref": "#/$defs/scopeMode" } }
    },
    "optimisticLock": {
      "type": "object", "additionalProperties": false, "required": ["field"],
      "properties": { "field": { "$ref": "#/$defs/id" } }
    },
    "audit": {
      "type": "object", "additionalProperties": false, "required": ["createdAt", "updatedAt"],
      "properties": { "createdAt": { "$ref": "#/$defs/id" }, "updatedAt": { "$ref": "#/$defs/id" }, "createdBy": { "$ref": "#/$defs/id" }, "updatedBy": { "$ref": "#/$defs/id" } }
    },
    "deletion": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": { "mode": { "enum": ["hard", "soft"] }, "field": { "$ref": "#/$defs/id" } },
      "allOf": [{ "if": { "properties": { "mode": { "const": "soft" } } }, "then": { "required": ["field"] } }]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$", "maxLength": 160 },
    "scopeMode": { "enum": ["none", "required"] },
    "fieldSet": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "column", "type", "nullable", "sensitivity"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "column": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "type": { "enum": ["string", "int64", "float64", "bool", "bytes", "timestamp", "json", "uuid"] },
        "nullable": { "type": "boolean" },
        "sensitivity": { "enum": ["public", "internal", "confidential", "secret"] }
      }
    },
    "index": {
      "type": "object", "additionalProperties": false, "required": ["id", "fields", "unique"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "fields": { "$ref": "#/$defs/fieldSet" }, "unique": { "type": "boolean" } }
    },
    "unique": {
      "type": "object", "additionalProperties": false, "required": ["id", "fields"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "fields": { "$ref": "#/$defs/fieldSet" } }
    }
  }
}
