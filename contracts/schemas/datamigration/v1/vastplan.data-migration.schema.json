{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cdsoft.com.cn/vastplan/datamigration/v1/vastplan.data-migration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "id", "modelId", "from", "to", "requiresBackup", "requiresApproval", "retrySafe", "providers"],
  "properties": {
    "contract": { "const": "data.migration.v1" },
    "id": { "$ref": "#/$defs/id" },
    "modelId": { "$ref": "#/$defs/id" },
    "from": { "$ref": "#/$defs/modelIdentity" },
    "to": { "$ref": "#/$defs/modelIdentity" },
    "requiresBackup": { "const": true },
    "requiresApproval": { "const": true },
    "retrySafe": { "const": true },
    "providers": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "$ref": "#/$defs/providerPlan" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)*$", "maxLength": 160 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "sha256"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "providerPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["providerId", "statements"],
      "properties": {
        "providerId": { "enum": ["postgresql", "mysql"] },
        "statements": {
          "type": "array", "minItems": 1, "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 32768 }
        }
      }
    }
  }
}
