{
  "version": 1,
  "revision": 2,
  "id": "cluster-demo",
  "target": {
    "kernel": "backend"
  },
  "metadata": {
    "name": "cluster-demo",
    "tenant": "acme"
  },
  "units": [
    {
      "serviceClass": "application.backend",
      "spec": {
        "id": "backend-main",
        "kind": "service",
        "enabled": true,
        "service_role": "backend",
        "logical_service": "cluster-demo.hello",
        "instance_policy": "active-active",
        "state_model": "external-shared",
        "visibility": "cluster",
        "routing": "queue",
        "routing_domain": "application",
        "replicas": 2,
        "placement": {
          "nodeSelector": {
            "region": "cn"
          }
        },
        "plugins": [
          {
            "id": "cn.vastplan.example.backend.hello-world",
            "version": "0.2.1",
            "channel": "stable"
          }
        ],
        "config": {
          "kernel_service_grants": {
            "cn.vastplan.example.backend.hello-world": ["kernel.info"]
          },
          "plugins": {
            "cn.vastplan.example.backend.hello-world": {
              "greetingTemplate": "你好，{{name}}！我是 VastPlan 租户级插件。"
            }
          }
        }
      }
    }
  ]
}
