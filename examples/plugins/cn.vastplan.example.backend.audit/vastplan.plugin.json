{
  "id": "cn.vastplan.example.backend.audit",
  "name": "示例审计",
  "version": "0.1.2",
  "publisher": "vastplan",
  "license": "Apache-2.0",
  "licenseFile": "LICENSE",
  "noticeFile": "NOTICE",
  "description": "演示 fanout 分发：订阅 task.* 事件并记录，另提供工具查询已记录的事件",
  "engines": { "backend": "^0.1 || ^1.0" },

  "capabilities": { "kernelServices": [], "credentials": [], "resources": [] },
  "contextAccess": { "required": ["scope.tenant", "caller", "scene", "trace"], "optional": ["request.deadline", "propagation.callPath"] },

  "activation": ["onStartup"],

  "runtime": {
    "instancePolicy": "active-active", "stateModel": "external-shared", "visibility": "cluster", "routing": "queue",
    "provides": [
      { "extensionPoint": "event.sink", "capability": "demo.audit.sink", "contractVersion": "1.0.0", "visibility": "cluster", "routing": "queue" },
      { "extensionPoint": "tool.package", "capability": "demo.audit", "contractVersion": "1.0.0", "visibility": "cluster", "routing": "queue" }
    ]
  },

  "entry": { "backend": "backend/demo-audit" },

  "contributes": {
    "backend": {
      "eventSinks": [
        {
          "id": "demo.audit.sink",
          "service_role": "backend",
          "title": "审计事件汇",
          "priority": 50,
          "subscribe": ["task.*", "plugin.activated"]
        }
      ],
      "tools": [
        {
          "id": "demo.audit",
          "service_role": "backend",
          "title": "审计查询",
          "subcommands": [
            { "name": "list", "description": "列出已记录的事件类型" }
          ]
        }
      ]
    }
  }
}
