            "foundation.approval-policy.native.profiles": [
              {
                "id": "seed.portal-publication",
                "revision": 1,
                "defaultEffect": "deny",
                "rules": [
                  {
                    "id": "seed.portal-publication.self-review",
                    "priority": 100,
                    "conditions": [
                      { "left": "actor.id", "operator": "equals", "rightFact": "resource.submittedBy" }
